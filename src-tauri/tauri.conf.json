{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bakehouse",
  "version": "0.1.0",
  "identifier": "com.bakehouse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bakehouse",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#131518"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": ["resources/container-runtime/**/*"],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "entitlements/app.entitlements"
    }
  }
}
