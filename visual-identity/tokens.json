{
  "$name": "Bakehouse",
  "$description": "Cold iron, hot ember. The interface is cool and technical; heat is reserved for data that is live.",
  "$version": "0.1.0",

  "color": {
    "brand": {
      "ember":      { "value": "#FF5A1F", "use": "Primary accent. Running instances, primary buttons, the logo." },
      "emberHot":   { "value": "#FF7A45", "use": "Hover and focus state for ember." },
      "emberDeep":  { "value": "#D93F0C", "use": "Pressed state, and ember on light backgrounds where #FF5A1F fails contrast." },
      "gold":       { "value": "#FFB020", "use": "Secondary accent. Work in progress: pulling, restoring, proofing." },
      "flour":      { "value": "#E8E6E1", "use": "Primary text on dark." },
      "iron":       { "value": "#131518", "use": "Deepest surface. The oven's cast iron." }
    },

    "dark": {
      "bg":            "#131518",
      "surface":       "#1A1D21",
      "surfaceRaised": "#23272C",
      "surfaceSunken": "#0E1013",
      "border":        "#2E333A",
      "borderStrong":  "#3D444C",
      "text":          "#E8E6E1",
      "textMuted":     "#98A0A8",
      "textFaint":     "#6C747C",
      "overlay":       "rgba(8, 10, 12, 0.72)"
    },

    "light": {
      "bg":            "#F1F0EC",
      "surface":       "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#E7E5DF",
      "border":        "#DBD9D2",
      "borderStrong":  "#C2BFB6",
      "text":          "#15181B",
      "textMuted":     "#5C636A",
      "textFaint":     "#8A9199",
      "overlay":       "rgba(19, 21, 24, 0.45)"
    },

    "state": {
      "$note": "Instance lifecycle. Hues are chosen to stay distinguishable from ember (#FF5A1F) and from each other under common color vision deficiencies. Never encode state with color alone — always pair with the listed glyph.",
      "running":  { "value": "#3DD68C", "glyph": "filled dot",        "label": "Running" },
      "starting": { "value": "#FFB020", "glyph": "pulsing ring",      "label": "Starting" },
      "pulling":  { "value": "#FFB020", "glyph": "progress arc",      "label": "Pulling image" },
      "stopped":  { "value": "#6C747C", "glyph": "hollow dot",        "label": "Stopped" },
      "failed":   { "value": "#F2385A", "glyph": "triangle",          "label": "Failed" },
      "info":     { "value": "#4EA3F5", "glyph": "circle i",          "label": "Info" }
    },

    "syntax": {
      "$note": "SQL editor. Keep the palette narrow — six colors, not twelve. Ember is deliberately absent so the editor never competes with instance status.",
      "keyword":     "#FF9E64",
      "string":      "#9ECE6A",
      "number":      "#E0AF68",
      "identifier":  "#E8E6E1",
      "function":    "#7AA2F7",
      "comment":     "#5E6673",
      "operator":    "#98A0A8",
      "cursor":      "#FF5A1F",
      "selection":   "rgba(255, 90, 31, 0.20)",
      "lineHighlight": "rgba(255, 255, 255, 0.035)"
    }
  },

  "font": {
    "display": {
      "family": "Fraunces",
      "fallback": "Georgia, 'Times New Roman', serif",
      "axes": { "opsz": 40, "wght": 600, "SOFT": 40, "WONK": 1 },
      "use": "Wordmark, empty-state headlines, onboarding. Nowhere else."
    },
    "ui": {
      "family": "Geist",
      "fallback": "-apple-system, BlinkMacSystemFont, system-ui, sans-serif",
      "use": "All interface text."
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "'IBM Plex Mono', 'SF Mono', ui-monospace, monospace",
      "use": "SQL editor, result grids, log output, connection strings.",
      "ligatures": false
    }
  },

  "typeScale": {
    "$note": "Minor third (1.2) from a 13px UI base, which matches native macOS density.",
    "micro":   { "size": "11px",   "lineHeight": "16px" },
    "small":   { "size": "12px",   "lineHeight": "18px" },
    "body":    { "size": "13px",   "lineHeight": "20px" },
    "large":   { "size": "15.5px", "lineHeight": "24px" },
    "title":   { "size": "19px",   "lineHeight": "26px" },
    "display": { "size": "27px",   "lineHeight": "32px" },
    "hero":    { "size": "39px",   "lineHeight": "44px" },
    "code":    { "size": "13px",   "lineHeight": "21px" }
  },

  "space": {
    "$note": "4px base. Panels use 12/16; dense grids use 4/8.",
    "0.5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px"
  },

  "radius": {
    "$note": "Radius encodes hierarchy. Controls are tight, panels are soft, the app frame is softest.",
    "control": "5px",
    "field":   "6px",
    "panel":   "10px",
    "modal":   "14px",
    "window":  "12px",
    "pill":    "999px"
  },

  "elevation": {
    "$note": "Dark UI reads depth through borders and background lightness, not shadow. Shadow is reserved for things that genuinely float.",
    "flat":    "none",
    "popover": "0 8px 24px rgba(0, 0, 0, 0.44), 0 0 0 1px rgba(255, 255, 255, 0.06)",
    "modal":   "0 24px 64px rgba(0, 0, 0, 0.56), 0 0 0 1px rgba(255, 255, 255, 0.08)",
    "emberGlow": "0 0 0 1px rgba(255, 90, 31, 0.35), 0 0 20px rgba(255, 90, 31, 0.18)"
  },

  "motion": {
    "$note": "Two durations and one easing. Motion confirms a change; it does not decorate.",
    "instant": "80ms",
    "quick":   "140ms",
    "settle":  "240ms",
    "easing":  "cubic-bezier(0.32, 0.72, 0, 1)",
    "proofPulse": "1800ms ease-in-out infinite"
  }
}
